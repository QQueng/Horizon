{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "extra_body": {
      "thinking": {
        "type": "disabled"
      }
    },
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 3
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "finance-news",
    "profile_settings": {
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": false
    },
    "reddit": {
      "enabled": false
    },
    "telegram": {
      "enabled": false
    },
    "rss": [
      {
        "name": "华尔街见闻",
        "url": "https://dedicated.wallstreetcn.com/rss.xml",
        "enabled": true,
        "category": "finance-markets",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "日经中文",
        "url": "https://cn.nikkei.com/rss.html",
        "enabled": true,
        "category": "finance-markets",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "FT中文网",
        "url": "https://www.ftchinese.com/rss/news",
        "enabled": true,
        "category": "finance-markets",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "经济观察网",
        "url": "https://www.eeo.com.cn/rss.xml",
        "enabled": true,
        "category": "finance-markets",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Investing.com 股市",
        "url": "https://www.investing.com/rss/news_25.rss",
        "enabled": true,
        "category": "finance-markets",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      }
    ]
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 10,
    "profile_order": [
      "finance-news"
    ],
    "category_groups": {
      "finance-markets": {
        "name": "财经与市场",
        "limit": 10,
        "categories": [
          "finance-markets"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL"
  },
  "wechat": {
    "enabled": false
  }
}
